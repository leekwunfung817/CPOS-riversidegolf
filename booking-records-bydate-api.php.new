<script>
  (function () {
    console.log('[group-toggle] script start');
    var table = document.getElementById('fair_way_table');
    console.log('[group-toggle] table lookup result:', table);
    if (!table) {
      console.log('[group-toggle] table not found, aborting');
      return;
    }

    var groupRows = table.querySelectorAll('.group_row');
    console.log('[group-toggle] group rows found:', groupRows.length, groupRows);

    function hasClass(element, className) {
      var result = (' ' + element.className + ' ').indexOf(' ' + className + ' ') > -1;
      console.log('[group-toggle] hasClass', className, 'on', element, '=>', result, 'current className=', element.className);
      return result;
    }

    function addClass(element, className) {
      console.log('[group-toggle] addClass before', className, 'on', element, 'className=', element.className);
      if (!hasClass(element, className)) {
        element.className = element.className ? element.className + ' ' + className : className;
      }
      console.log('[group-toggle] addClass after', className, 'on', element, 'className=', element.className);
    }

    function removeClass(element, className) {
      console.log('[group-toggle] removeClass before', className, 'on', element, 'className=', element.className);
      var classString = ' ' + element.className + ' ';
      while (classString.indexOf(' ' + className + ' ') > -1) {
        classString = classString.replace(' ' + className + ' ', ' ');
      }
      element.className = classString.replace(/^\s+|\s+$/g, '');
      console.log('[group-toggle] removeClass after', className, 'on', element, 'className=', element.className);
    }

    function toggleGroup(groupRow) {
      console.log('[group-toggle] toggleGroup called with row:', groupRow);
      var groupId = groupRow.getAttribute('data-group');
      var headerCell = groupRow.getElementsByTagName('th')[0];
      var icon = groupRow.querySelector('.group_toggle_icon');
      var memberRows = table.querySelectorAll('.time_row[data-group="' + groupId + '"]');
      var isExpanded = headerCell.getAttribute('aria-expanded') !== 'false';
      var index;

      console.log('[group-toggle] groupId=', groupId);
      console.log('[group-toggle] headerCell=', headerCell);
      console.log('[group-toggle] icon=', icon);
      console.log('[group-toggle] memberRows length=', memberRows.length, memberRows);
      console.log('[group-toggle] current expanded state=', isExpanded, 'aria-expanded=', headerCell.getAttribute('aria-expanded'));

      for (index = 0; index < memberRows.length; index++) {
        console.log('[group-toggle] processing member row index', index, memberRows[index], 'className before=', memberRows[index].className);
        if (isExpanded) {
          addClass(memberRows[index], 'is-hidden');
        } else {
          removeClass(memberRows[index], 'is-hidden');
        }
        console.log('[group-toggle] member row index', index, 'className after=', memberRows[index].className);
      }

      headerCell.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      console.log('[group-toggle] new aria-expanded=', headerCell.getAttribute('aria-expanded'));
      if (icon) {
        icon.innerHTML = isExpanded ? '&#9654;' : '&#9660;';
        console.log('[group-toggle] icon updated to=', icon.innerHTML);
      } else {
        console.log('[group-toggle] icon not found for groupId=', groupId);
      }

      console.log('[group-toggle] toggleGroup finished for groupId=', groupId);
    }

    var rowIndex;
    for (rowIndex = 0; rowIndex < groupRows.length; rowIndex++) {
      console.log('[group-toggle] binding click handler for rowIndex=', rowIndex, 'group=', groupRows[rowIndex].getAttribute('data-group'), groupRows[rowIndex]);
      groupRows[rowIndex].onclick = function () {
        console.log('[group-toggle] click event fired for row=', this, 'group=', this.getAttribute('data-group'));
        toggleGroup(this);
      };
    }

    console.log('[group-toggle] script setup complete');
  }());
</script>
